# Copie para .env e preencha. NUNCA commite o .env.
# Telegram — destino existente das ofertas (não alterar para usar o digest).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@seu_canal_ou_-1001234567890
# Destino separado do digest diário de AI/tecnologia (chat privado).
TELEGRAM_NEWS_CHAT_ID=

# Mercado Livre — sua etiqueta de afiliado (matt_tool).
# Ex.: 35439858 (pauloclark)
ML_AFFILIATE_TAG=35439858
# Rótulo de tracking opcional (vai no matt_word)
ML_AFFILIATE_LABEL=ofertas-bot

# Mercado Livre — credenciais da aplicação (developers.mercadolivre.com.br).
# O bot emite um access_token por execução (client_credentials) e busca
# autenticado: a busca pública devolve 403 em IPs de datacenter (VM e
# runners do GitHub), e o token pode destravar. Sem isso, busca sem auth.
# Para postar uma oferta específica do ML manualmente, use o workflow
# `.github/workflows/post-ml-deal.yml` (ou `node src/ml/postDeal.ts`).
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Shopee — credenciais da Affiliate Open API (app_id + secret_key).
# O acesso é liberado pela Shopee e pode levar até 2 semanas.
SHOPEE_API_APP_ID=
SHOPEE_API_SECRET=

# Amazon — tracking ID do Associates (ex.: lin63-20, o mesmo do Peleia).
# Plano C: busca via Firecrawl Cloud — o bot raspa a página de busca da
# amazon.com.br e extrai ASIN/preço (ver src/amazon/firecrawl.ts), com
# cache diário em data/amazon-cache.json (1 raspagem por keyword/dia ≈
# ~5 créditos/dia, ~110/mês — economiza 75% dos créditos).
# Sem a chave, o bot volta ao plano B (lista curada abaixo).
FIRECRAWL_API_KEY=
# Plano B: as ofertas vêm da lista curada em data/amazon-deals.json
# (conferida no navegador); o bot só anexa ?tag= a cada link.
# Plano A (futuro): Product Advertising API — exige vendas qualificadas.
AMAZON_AFFILIATE_TAG=

# Brindes grátis (Epic + GamerPower, postados em PT-BR)
# Fontes: epic,gamerpower (padrão: as duas). Máx. 3 brindes por execução.
FREEBIE_SOURCES=epic,gamerpower
FREEBIE_MAX_PER_RUN=3
# E-mail enviado no parâmetro `de` da API MyMemory (qualquer e-mail válido,
# sem precisar gerar key): sem ele, cota anônima (~5 mil caracteres/dia por IP,
# instável em datacenter). Com ele: 50 mil caracteres/dia.
MYMEMORY_EMAIL=

# Regras do bot e filtro de qualidade
DEAL_KEYWORDS=capacete ciclismo,tenis corrida,garmin,air fryer,fone bluetooth
DEAL_MIN_DISCOUNT_PCT=20
DEAL_MAX_DISCOUNT_PCT=85
DEAL_MIN_PRICE=10
DEAL_MIN_RATING=4
DEAL_MIN_SALES=10
DEAL_MAX_POSTS_PER_RUN=5
DEAL_STORES=ml,shopee,amazon
DATA_DIR=./data
